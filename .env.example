# Database configuration — copy this file to .env and fill in the values.
# .env is gitignored: real credentials never reach the repository.

DB_USER=kuantorflow
DB_PASSWORD=your-password-here

# For local development with MySQL on your machine:
DB_HOST=localhost
DB_NAME=kuantorflow

# On PythonAnywhere, omit DB_HOST and DB_NAME (or delete those lines):
# they default to <DB_USER>.mysql.pythonanywhere-services.com
# and <DB_USER>$default.

# REQUIRED. The key the Flask session cookie is signed with. The cookie is
# signed, not encrypted, so this signature is the only thing that stops a
# visitor writing their own cookie saying they are the admin (#445). The app
# refuses to start without it; `python app.py` alone falls back to a random
# key for that run, which means sessions do not survive a restart.
#
# Generate one:   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Whether the session cookie — which carries the signed-in identity — is
# marked Secure, so the browser only ever sends it over HTTPS (issue #274).
# On by default, which is what the deployed app wants. `python app.py` turns it
# off by itself for local http://localhost, so this is only needed to override
# that: set it to 1 when serving locally over HTTPS, or to 0 to reproduce the
# local behaviour under a WSGI server.
# SESSION_COOKIE_SECURE=1

# ACCESS_KEYWORD is gone (#199). The site used to be behind a keyword gate;
# it is now open, and every paid action is bounded by a daily ceiling instead
# — see the limits below. A value left here is simply ignored.

# The daily ceilings on every paid action (#199, #447, #456). These are the
# code's own defaults (web.py), so leaving a line out changes nothing; a value
# set here overrides it, and 0 turns that one ceiling off. Each action has up
# to four, and a refusal says which one ran out (the guide's "Why you might be
# asked to come back tomorrow"):
#   *_ANON_LIMIT / ANONYMOUS_MESSAGE_LIMIT  per browser session, signed out: a
#       nudge towards signing in, since clearing cookies resets it
#   *_USER_DAILY       per account, per day: signing in raises a limit, it
#       does not remove one
#   *_ANON_DAILY / ANONYMOUS_DAILY_LIMIT    everyone signed out, together
#   *_ALL_DAILY / *_DAILY_LIMIT             everybody, per day: what bounds
#       the bill. Every anonymous pool stays well below its site-wide one, or
#       signed-out visitors can use up the whole site's day.
# Before changing a default in web.py, note that the guide's limits table
# states these numbers to learners, and a test holds the guide to the code.

# Talking to Mykola (#164, #456). The expensive one: Mykola answers on Opus.
ANONYMOUS_MESSAGE_LIMIT=10
ANONYMOUS_DAILY_LIMIT=15
CHAT_USER_DAILY=40
CHAT_ALL_DAILY=40
# The longest single message, checked before either quota (#564).
MAX_CHAT_MESSAGE_CHARS=2000

# Looking a word up (#199, #456).
LOOKUP_ANON_LIMIT=3
LOOKUP_USER_DAILY=50
LOOKUP_ANON_DAILY=150
LOOKUP_ALL_DAILY=250

# Generating a text (#237, #456).
GENERATION_ANON_LIMIT=1
GENERATION_USER_DAILY=10
GENERATION_ANON_DAILY=20
GENERATION_DAILY_LIMIT=60

# A recap of past conversations, and importing notes: accounts only (#447).
RECAP_USER_DAILY=5
RECAP_ALL_DAILY=10
UPLOAD_USER_DAILY=10
UPLOAD_ALL_DAILY=40

# Checking quiz answers close in meaning, one per round (#612).
CHECK_USER_DAILY=30
CHECK_ANON_DAILY=30
CHECK_ALL_DAILY=150

# Administrators, comma-separated. Matched case-insensitively against the
# verified Google email of the signed-in visitor (issue #158). Leave unset or
# empty and the site simply has no admin. Requires Google sign-in below: an
# anonymous visitor is never an admin, and an address Google has not verified
# never matches.
ADMIN_EMAILS=

# --- Admin emails (#591) ---------------------------------------------------
# The site can email the admin about what happens on it: a new account (#592),
# a daily activity report (#593), a learner nearing a daily limit (#594).
# Leave SMTP_HOST empty and nothing is ever sent -- the right setting for
# local development. Check the settings with:
#   venv/bin/python scripts/send_test_email.py
#
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER is the sending Gmail address,
# and SMTP_PASSWORD is an **app password** for it (Google account -> Security ->
# 2-Step Verification -> App passwords), never the account's own password.
# Set the real one only in the server's .env, never in this file.
# SMTP_PORT is 587 (STARTTLS) by default, or 465 (SSL).
# NOTIFY_EMAIL is who receives them; empty means the first ADMIN_EMAILS address.
# NOTIFY_DRY_RUN=1 logs each email to logs/notify.log instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL=
NOTIFY_DRY_RUN=0
# When an account reaches this percent of one of its daily limits, the admin is
# emailed once that day for that limit (#594). 0 turns the warning off.
NOTIFY_LIMIT_PERCENT=80

# Optional "Sign in with Google" for Mykola. Leave both blank to disable the
# feature (no sign-in button appears). To enable: create an OAuth 2.0 Client ID
# (type: Web application) in Google Cloud Console, add these redirect URIs —
#   https://<your-user>.pythonanywhere.com/auth/google/callback   (production)
#   http://localhost:5000/auth/google/callback                    (local dev)
# — then paste the client ID and secret below. Also set a real SECRET_KEY above
# (the session stores the signed-in identity).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Translation (#353) -----------------------------------------------------
# The Settings panel offers whichever of these is configured, and nothing else.
# With none of them set, a lookup still works: the card comes back with its
# English explanation and examples and no translations (#349), and a later
# lookup fills them in once a provider is available.
#
# The scraped Google and Bing backends were retired here — they called
# endpoints nobody offered us, and #348 is both of them being withdrawn on the
# same day.
#
# Claude is the default and needs no new account: ANTHROPIC_API_KEY is the same
# key Mykola uses. **Set it here** (#412). It is also the only free-form
# provider that returns translations grouped by part of speech, which is what
# lets one lookup make a noun card and a verb card.
#
# It used to be read from ai_agent/.env, which happened to work because
# importing the agent loads that file -- so the word lookup, #237's generated
# text and #406's topic builder all depended on a repo none of them uses. This
# file is loaded first (utils.py) and a value set here wins, so the agent's
# copy is now a fallback rather than the route. Keep the two in step: rotating
# the key means rotating **both** files.
#
# DeepL and Google Cloud translate a string and do not classify it, so a card
# from either gets a single part of speech. Microsoft has a dictionary endpoint
# and does group.
#
#   ANTHROPIC_API_KEY        Claude                       (default)
#   MS_TRANSLATOR_KEY        Microsoft Translator         groups by part of speech
#   MS_TRANSLATOR_REGION     required for a regional Azure resource, omit for global
#   DEEPL_API_KEY            DeepL                        one card per word
#   GOOGLE_TRANSLATE_API_KEY Google Cloud Translation     one card per word
ANTHROPIC_API_KEY=
MS_TRANSLATOR_KEY=
MS_TRANSLATOR_REGION=
DEEPL_API_KEY=
GOOGLE_TRANSLATE_API_KEY=

# --- Explanatory dictionary (ENG -> ENG) ------------------------------------
#
# Oxford Learner's needs no key and is the default. Merriam-Webster is offered
# only where MERRIAM_WEBSTER_API_KEY is set (#365), and the Settings panel
# greys it with that name where it is not.
#
# Setting it today unlocks less than it looks like: the backend still scrapes
# merriam-webster.com and sends no key anywhere, and that site answers 403 to
# PythonAnywhere's IPs. #110 is the ticket that migrates it to the official
# API, at which point this variable is what pays for the request.
MERRIAM_WEBSTER_API_KEY=
